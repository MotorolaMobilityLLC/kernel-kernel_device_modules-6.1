&mtk_leds {
	backlight {
		/delete-property/ max-hw-brightness;
		/delete-property/ max-brightness;
		max-brightness = <4080>;
		max-hw-brightness = <4080>;
	};
};

&mipi_tx_config0 {
	mipi-volt = <11>;
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	panel1@0 {
		/delete-property/ compatible;
		/delete-property/ pm-enable-gpios;
		/delete-property/ reset-gpios;
		/delete-property/ gate-ic;
		/delete-property/ swap-from-dts;
		/delete-property/ lane-swap-setting;
		/delete-property/ pn-swap-setting;

                compatible = "mot,dummy,vdo,60hz";
                reg = <0>;
                reset-gpios = <&pio 41 0>;
		pinctrl-names = "default";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	panel2@1 {
		/delete-property/ compatible;
		/delete-property/ pm-enable-gpios;
		/delete-property/ reset-gpios;
		/delete-property/ gate-ic;

		compatible = "csot,vtdr6130,cmd,ltpo";
		reg = <1>;

                pm-enable-gpios = <&pio 185 0>,
                          <&pio 186 0>,
                          <&pio 184 0>;
                reset-gpios = <&pio 41 0>;
		pinctrl-names = "default";
		port {
			panel_in2: endpoint {
				remote-endpoint = <&dsi_out2>;
			};
		};
	};
	panel3@2 {
		/delete-property/ compatible;
		/delete-property/ pm-enable-gpios;
		/delete-property/ reset-gpios;
		/delete-property/ gate-ic;

		compatible = "csot,ft3683g,cmd,ltpo";
		reg = <2>;

                pm-enable-gpios = <&pio 185 0>,
                          <&pio 186 0>,
                          <&pio 184 0>;
                reset-gpios = <&pio 41 0>;
		pinctrl-names = "default";
		port {
			panel_in3: endpoint {
				remote-endpoint = <&dsi_out3>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
			dsi_out2: endpoint2 {
				remote-endpoint = <&panel_in2>;
			};
			dsi_out3: endpoint3 {
				remote-endpoint = <&panel_in3>;
			};
		};
	};
};


&mtkfb {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-1;
	/delete-property/ pinctrl-2;
	/delete-property/ pinctrl-3;
	/delete-property/ pinctrl-4;
	/delete-property/ pinctrl-5;
	/delete-property/ pinctrl-6;
	/delete-property/ pinctrl-7;
	/delete-property/ pinctrl-8;
	/delete-property/ pinctrl-9;
	/delete-property/ pinctrl-10;

	pinctrl-names = "lcm_rst_out0_gpio", "mode_te_te",
		"oled_vci_en_gpio", "oled_vio_en_gpio",
		"oled_dvdd_en_gpio","oled_dvdd_in_en_gpio";

	pinctrl-0 = <&mtkfb_pins_lcm_rst_out_gpio>;
	pinctrl-1 = <&mtkfb_pins_lcm_dsi_te>;
	pinctrl-2 = <&mtkfb_pins_oled_vci_en>;
	pinctrl-3 = <&mtkfb_pins_oled_vio_en>;
	pinctrl-4 = <&mtkfb_pins_oled_dvdd_en>;
	pinctrl-5 = <&mtkfb_pins_oled_dvdd_in_en>;

	status = "okay";

};


&pio {
	mtkfb_pins_oled_vci_en: oled_vci_en_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO184__FUNC_GPIO184>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_oled_vio_en: oled_vio_en_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO185__FUNC_GPIO185>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_oled_dvdd_en: oled_dvdd_en_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO186__FUNC_GPIO186>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_oled_dvdd_in_en: oled_dvdd_in_en_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO62__FUNC_GPIO62>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcm_rst_out_gpio: lcm_rst_out_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO41__FUNC_GPIO41>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&i2c6 {
	gate_ic: gate-ic@11 {
		status = "disabled";
	};
};

&ps5170 {
       status = "disabled";
};

&i2c13 {
	ps5169: ps5169@30 {
		compatible = "parade,ps5170";
		reg = <0x30>;
		mediatek,vs-voter = <&pmic 0x189a 0x20 1>;
		pinctrl-names = "enable", "disable";
		pinctrl-0 = <&ps_enable>;
		pinctrl-1 = <&ps_disable>;

		ps5169,reg-num = <22>;
		ps5169,reg-init = <
			0x51 0x87
			0x50 0x10
			0x54 0x11
			0x5d 0x56
			0x52 0x20
			0x55 0x00
			0x56 0x00
			0x57 0x00
			0x58 0x00
			0x59 0x00
			0x5a 0x00
			0x5b 0x00
			0x5e 0x06
			0x5f 0x00
			0x60 0x00
			0x61 0x03
			0x65 0x40
			0x66 0x00
			0x67 0x03
			0x75 0x0c
			0x77 0x00
			0x78 0x7c
		>;

		status = "okay";
	};
};

&dp_tx {
	mtk-dp-downgrade;
};

&dispsys_config {
	force-disable-idlemgr-by-repaint;

	helper-value = <0>, /*MTK_DRM_OPT_STAGE*/
		<1>, /*MTK_DRM_OPT_USE_CMDQ*/
		<1>, /*MTK_DRM_OPT_USE_M4U*/
		<1>, /*MTK_DRM_OPT_MMQOS_SUPPORT*/
		<1>, /*MTK_DRM_OPT_MMDVFS_SUPPORT*/
		<0>, /*MTK_DRM_OPT_SODI_SUPPORT*/
		<1>, /*MTK_DRM_OPT_IDLE_MGR*/
		<0>, /*MTK_DRM_OPT_IDLEMGR_SWTCH_DECOUPLE*/
		<1>, /*MTK_DRM_OPT_IDLEMGR_BY_REPAINT*/
		<0>, /*MTK_DRM_OPT_IDLEMGR_ENTER_ULPS*/
		<0>, /*MTK_DRM_OPT_IDLEMGR_KEEP_LP11*/
